#!/bin/bash

file=$1

func() {
  echo "$1;	$2;	$3;	$4" >> "$file"
}

while true
do
  echo "1 - добавить, 2 - показать, 0 - выход"
  choice=""
  read choice
  
  case $choice in
  1)
    echo "Дата:"
    read date
    echo "Категория:"
    read category
    echo "Сумма:"
    read amount
    echo "Описание:"
    read description
    func "$date" "$category" "$amount" "$description"
   ;;
   2)
    cat "$file"
   ;;
   0)
    break
   ;;
   *)
    echo "Неизвестная команда"
   ;;
   esac
done
